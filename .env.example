# Port on which the unified HTTP & WebSocket server runs (Render sets this automatically to 10000)
PORT=5000

# Environment mode
NODE_ENV=production

# Gemini AI API Key (optional - system falls back gracefully to deterministic multi-task AI copilot)
GEMINI_API_KEY=""

# Public Application URL (optional)
APP_URL="http://localhost:5000"

# JWT Secret for government token signatures
JWT_SECRET="nagar-drishti-secure-gov-jwt-key-2026"

# CORS Origin (* or your custom domain)
CORS_ORIGIN="*"

# Enable autonomous city bus edge telemetry simulation
ENABLE_TELEMETRY_SIMULATION="true"

# Interval between autonomous telemetry updates (ms)
SIMULATION_INTERVAL_MS="6000"

